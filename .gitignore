# --- Python Basics ---
__pycache__/
*.py[cod]
*$py.class

# --- Virtual Environments (Conda/Venv) ---
env/
venv/
.venv/
conda-env/

# --- PyInstaller (The heavy build files) ---
build/
dist/
*.spec

# --- OS Junk Files ---
.DS_Store
Thumbs.db

# --- IDE Settings (Optional but recommended) ---
.vscode/
.idea/

# --- Project Specific Temporaries ---
# Ignore all temp audio files from the server
temp_*.wav
# Ignore the voices folder if you don't want to share cloned voices
voices/
# Ignore your local config if it has keys (though your config.py is safer now)
# config.json 

# --- Analytics Data ---
# Ignore the generated CSV reports
benchmark_results.csv
server_metrics.csv

# Ignore any charts/images generated by the report scripts
*.png
*.jpg